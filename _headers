# Regras de cache para Cloudflare Pages

# Fontes nunca mudam -> cache longo e imutavel
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Imagens -> cache de 30 dias
/img/*
  Cache-Control: public, max-age=2592000

# Arquivos da agenda -> sempre revalidar (evita cache preso entre HTML e JS)
/css/agenda.css
  Cache-Control: no-cache
/js/agendar.js
  Cache-Control: no-cache
/js/admin-agenda.js
  Cache-Control: no-cache

# CSS e JS -> cache de 1 dia
/css/*
  Cache-Control: public, max-age=86400
/js/*
  Cache-Control: public, max-age=86400

# Paginas ocultas da agenda -> fora dos buscadores e sem cache
/agendar-reuniao*
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: no-store
  Referrer-Policy: no-referrer
/kai-agenda-admin*
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: no-store
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
